# QubitEdge Backend — Environment Variables template

# Leave blank to run AI Tutor in mock/demo mode
GEMINI_API_KEY=

# Optional: Switch to a different Gemini model
GEMINI_MODEL=gemini-1.5-flash

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
